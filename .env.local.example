# ─── SHARED with backend (same value in both Railway services) ────────────────
# Bearer token the frontend sends and the backend validates. Must match the
# backend's APP_API_TOKEN exactly.
# Generate once: openssl rand -hex 32
APP_API_TOKEN=your-shared-api-token-here

# Public URL of the backend service. On Railway this is the backend's domain.
BACKEND_URL=http://localhost:8000

# Optional: private URL for server-side calls, so proxied requests stay on
# Railway's internal network instead of going out and back. Preferred over
# BACKEND_URL when set.
# BACKEND_INTERNAL_URL=http://assistent-be.railway.internal:8000

# ─── Auth.js (Google sign-in) ─────────────────────────────────────────────────
# Read by next-auth directly from the environment — they never appear in the
# source, so a missing one fails at sign-in rather than at build.
#
# Signs the session cookie. Generate: openssl rand -hex 32
AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32

# From the Google Cloud console OAuth client (Web application).
AUTH_GOOGLE_ID=...apps.googleusercontent.com
AUTH_GOOGLE_SECRET=...

# The app's own public URL. Behind Railway's proxy Auth.js cannot infer it, so
# set it explicitly — the OAuth callback is built from this value.
# Register <AUTH_URL>/api/auth/callback/google as an authorized redirect URI
# on the Google OAuth client.
AUTH_URL=https://your-frontend.up.railway.app

# ─── Note ─────────────────────────────────────────────────────────────────────
# There is no allowlist here. Who may sign in is decided by the backend's
# GOOGLE_EMAIL_MAP: on sign-in the frontend posts the Google account to
# /contacts/link-google and the backend returns the canonical person id, or
# refuses. One source of truth, so the two services cannot disagree.
